FROM node:24-alpine AS frontend
WORKDIR /src/ui
COPY ui/package.json ui/yarn.lock ./
RUN yarn install --frozen-lockfile --ignore-scripts
COPY schema.graphql /src/schema.graphql
COPY ui/ ./
RUN yarn generate && yarn build

FROM golang:1.25.14-alpine AS backend
RUN apk add --no-cache gcc musl-dev git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go install github.com/99designs/gqlgen@v0.17.85
COPY . .
RUN gqlgen generate
COPY --from=frontend /src/ui/build ./ui/build
ARG SOURCE_REVISION=unknown
RUN CGO_ENABLED=1 go build -trimpath -tags 'netgo osusergo sqlite_omit_load_extension' \
    -ldflags "-s -w -linkmode external -extldflags '-static' -X main.BuildMode=prod -X main.BuildVersion=hardened-candidate -X main.BuildCommit=${SOURCE_REVISION}" \
    -o /traggo .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && mkdir -p /opt/traggo/data
WORKDIR /opt/traggo
COPY --from=backend /traggo ./traggo
COPY LICENSE /usr/share/licenses/traggo/LICENSE
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/WeltenbummlerKA/traggo-server" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.licenses="GPL-3.0"
EXPOSE 3030
ENTRYPOINT ["/opt/traggo/traggo"]
